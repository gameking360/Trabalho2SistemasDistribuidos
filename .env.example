# Copie este arquivo para .env (já ignorado pelo Git) e defina uma senha própria:
#   cp .env.example .env
#
# O mesmo .env é usado pelo docker compose (criação do usuário e do virtual host no RabbitMQ)
# e pelos projetos .NET ao executar com `dotnet run` (carregado por DotEnvFile, sem sobrescrever
# variáveis de ambiente já definidas). Os nomes seguem o padrão de configuração do .NET (Secao__Chave).
RabbitMq__UserName=commerce
RabbitMq__Password=troque-esta-senha
RabbitMq__VirtualHost=commerce
